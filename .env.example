# Browser me bhi chahiye (direct upload ke liye)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# ================= Admin Panel =================
# Admin ka username/password ab MongoDB me save hota hai (AdminUser collection).
# Pehli baar /admin kholne par khud setup screen aayegi — wahin id-password banayein.
# Terminal se banana ho to:  npm run create-admin -- <username> <password>
# Koi bhi lamba random text (login cookie sign karne ke liye)
